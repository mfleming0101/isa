// The C extension rows: the 16-bit compressed encodings.
.{
    .{ .name = "C.ADDI16SP_374", .group = "c", .class = "data_processing", .bits = "011i00010abcce01", .text = "c.addi16sp sp, {icbea4}", .when = .{.{ .letters = "iabce", .ne = 0 }} },
